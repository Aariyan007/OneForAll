# Copy to .env.local and fill in. Never commit .env.local. See docs/manual-setup-checklist.md for every variable.
# Local Supabase values come from `npx supabase status` after `npm run db:start`.

# Public: safe to expose to the browser. Access is enforced by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Absolute app origin, used to build auth email redirect links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------------------------------------------
# Server-only secrets. Never prefix with NEXT_PUBLIC_. Never commit real values.

# HMAC key that signs structure analyses and file manifests (>= 32 random characters). The SAME value must be stored
# in Supabase Vault as `structure_persist_key` (see docs/manual-setup-checklist.md).
STRUCTURE_PERSIST_KEY=

# Encrypts integration credentials (GitHub token, Jira API token) before they are stored (>= 32 random characters).
# Server-only; NOT stored in Vault. Without it, tokens cannot be saved (public GitHub imports still work).
INTEGRATION_ENCRYPTION_KEY=

# Public origin used in invitation links, read at runtime (no rebuild needed). Set it to the URL people actually open,
# e.g. a tunnel or deployed URL. Empty: the inviter's own origin, then NEXT_PUBLIC_SITE_URL.
APP_URL=

# Outgoing email for invitations (server-only). Gmail: SMTP_USER is the Gmail address and SMTP_PASSWORD a Google
# "app password" (needs 2-Step Verification), never the account password. Empty: no email is sent; the inviter copies
# the link instead. SMTP_HOST defaults to smtp.gmail.com, SMTP_PORT to 465, SMTP_FROM to "OneForAll <SMTP_USER>".
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=
SMTP_PORT=
SMTP_FROM=

# Google Gemini key for the AI Assistant (server-only). Create one at https://aistudio.google.com/apikey.
# Empty: the assistant shows "not configured" and no AI request is made.
GEMINI_API_KEY=
# Optional model overrides (defaults: fast gemini-3.5-flash-lite, standard gemini-3.8-flash; deep is off).
AI_MODEL_FAST=
AI_MODEL_STANDARD=
AI_MODEL_DEEP=
