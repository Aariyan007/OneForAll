# Copy to .env.local and fill in. Never commit .env.local. See docs/manual-setup-checklist.md for every variable.
# Local Supabase values come from `npx supabase status` after `npm run db:start`.

# Public: safe to expose to the browser. Access is enforced by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Absolute app origin, used to build auth email redirect links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------------------------------------------
# Server-only secrets. Never prefix with NEXT_PUBLIC_. Never commit real values.

# HMAC key that signs structure analyses and file manifests (>= 32 random characters). The SAME value must be stored
# in Supabase Vault as `structure_persist_key` (see docs/manual-setup-checklist.md).
STRUCTURE_PERSIST_KEY=

# Encrypts integration credentials (GitHub token, Jira API token) before they are stored (>= 32 random characters).
# Server-only; NOT stored in Vault. Without it, tokens cannot be saved (public GitHub imports still work).
INTEGRATION_ENCRYPTION_KEY=
